# === 应用 ===
APP_SECRET_KEY=please-change-to-a-random-long-string
# 部署到公网后，改成反向代理对外的完整 HTTPS 地址，例如 https://classrecord.example.com
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_AFTER_LOGIN_PATH=/
# 生产环境（HTTPS）保持为 true；纯本地 http 调试可临时改为 false
COOKIE_SECURE=true
# 前端开发服务器地址，用逗号分隔，生产环境同源部署时可留空
CORS_ORIGINS=

# === Zitadel OIDC ===
# 你自己部署的 Zitadel 实例地址，例如 https://auth.example.com
ZITADEL_ISSUER=https://your-zitadel-domain
# 在 Zitadel 中创建的应用 Client ID
ZITADEL_CLIENT_ID=
# 如果创建的是 Confidential 类型应用会有 Client Secret；PKCE 公共客户端可留空
ZITADEL_CLIENT_SECRET=

# === 存储 ===
DATABASE_URL=sqlite:///./data/classrecord.db
STORAGE_DIR=./data/recordings

# === Whisper（本地部署） ===
WHISPER_MODEL_SIZE=large-v3
# 有 GPU 用 cuda，没有用 cpu
WHISPER_DEVICE=cpu
# GPU 环境建议 float16，CPU 环境建议 int8
WHISPER_COMPUTE_TYPE=int8
# 领域热词提示：课程专有名词/术语/人名，逗号分隔，可显著提升专有名词识别准确率
# 例：WHISPER_INITIAL_PROMPT=卷积神经网络，反向传播，梯度下降，损失函数
WHISPER_INITIAL_PROMPT=

# === 大模型总结（OpenAI 兼容接口）===
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
